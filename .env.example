# Anthropic API
ANTHROPIC_API_KEY=

# Database (provided by Vercel Postgres)
POSTGRES_URL=

# NextAuth
NEXTAUTH_SECRET=
# For local/self-hosted setups, you can explicitly set NEXTAUTH_URL, e.g.:
# NEXTAUTH_URL=http://localhost:3000
# On Vercel, NEXTAUTH_URL is typically not needed — trustHost: true derives the URL from the Host header

# App
CLAUDE_MODEL_ID=claude-sonnet-4-6-20250514

# Admin account passwords (used by `npm run db:seed-admins`)
ADMIN_THESSARIAN_PASSWORD=
ADMIN_MARCUS_PASSWORD=
ADMIN_LYRALEI_PASSWORD=
ADMIN_KESS_PASSWORD=
ADMIN_VELANI_PASSWORD=
