# Anthropic API
ANTHROPIC_API_KEY=

# Database (provided by Vercel Postgres)
POSTGRES_URL=

# NextAuth
NEXTAUTH_SECRET=
# Discord sign-in: https://discord.com/developers/applications -> OAuth2.
# Redirect URI must be listed there exactly:
#   https://snarl-web.vercel.app/api/auth/callback/discord
#   http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Discord user ids (comma-separated) that are admins the moment they sign in.
# Find yours: Discord > Settings > Advanced > Developer Mode, then right-click
# your name > Copy User ID. Or: SELECT discord_id FROM users WHERE ...
ADMIN_DISCORD_IDS=
# For local/self-hosted setups, you can explicitly set NEXTAUTH_URL, e.g.:
# NEXTAUTH_URL=http://localhost:3000
# On Vercel, NEXTAUTH_URL is typically not needed — trustHost: true derives the URL from the Host header

# Model (bare ids, no date suffix). Any of the three is a drop-in:
#   claude-sonnet-5-5 (default) | claude-opus-5-5 | claude-haiku-5-5
CLAUDE_MODEL_ID=claude-sonnet-5-5
# Reasoning depth: low | medium | high | xhigh | max (default medium;
# anything else falls back to medium with a warning in the function logs)
CLAUDE_EFFORT=medium
# Set to 1 to log per-step token usage (input/cache read/cache write/output)
# CLAUDE_DEBUG=1

# Admin account passwords (used by `npm run db:seed-admins`)
ADMIN_THESSARIAN_PASSWORD=
ADMIN_MARCUS_PASSWORD=
ADMIN_LYRALEI_PASSWORD=
ADMIN_KESS_PASSWORD=
ADMIN_VELANI_PASSWORD=
